{
  "name": "vscode-ashare-watch",
  "displayName": "A-Share Watch",
  "publisher": "ashare-watch",
  "description": "Track A-Share stock prices in VS Code Status Bar",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:stockManagerView"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "A-Share Watch",
      "properties": {
        "ashare-watch.stocks": {
          "type": "array",
          "default": [
            "sh600519",
            "sz000001"
          ],
          "description": "List of stock codes to track (e.g., sh600519, sz000001)"
        },
        "ashare-watch.updateInterval": {
          "type": "number",
          "default": 5000,
          "description": "Update interval in milliseconds"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "stockManager",
          "title": "股票管理",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "stockManager": [
        {
          "type": "webview",
          "id": "stockManagerView",
          "name": "自选股管理"
        }
      ]
    },
    "commands": [
      {
        "command": "ashare-watch.refresh",
        "title": "刷新股票数据"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3"
  }
}
